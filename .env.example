# Puertos en el host (docker compose). Cambiarlos si ya hay otro Postgres/Redis corriendo.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

DATABASE_URL=postgresql+asyncpg://colectivos:colectivos@localhost:5432/colectivos
REDIS_URL=redis://localhost:6379/0
ADMIN_API_KEY=cambia-esta-clave
ROUTE_BUFFER_M=40
